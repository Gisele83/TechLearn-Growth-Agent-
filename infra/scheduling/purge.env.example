# Variables de la tâche de purge. À placer dans /etc/growth-agent/purge.env,
# en mode 0600 et appartenant à l'utilisateur growth.
#
# AUCUNE VALEUR RÉELLE ICI.

GA_ENVIRONMENT=production
GA_DATABASE_URL=
GA_SECRET_KEY=

# La purge doit être activée explicitement.
GA_PURGE_ENABLED=false

# Durées de conservation, en jours.
GA_DATA_RETENTION_DAYS=365
GA_DRAFT_RETENTION_DAYS=180
GA_AUDIT_RETENTION_DAYS=1095
GA_PILOT_EVENT_RETENTION_DAYS=1825

# Garde-fous. Les abaisser rend la purge plus prudente, jamais plus permissive.
GA_PURGE_MAX_RECORDS_PER_RUN=5000
GA_PURGE_MAX_TABLE_RATIO=0.5
GA_PURGE_BATCH_SIZE=200
GA_PURGE_LOCK_TIMEOUT_MINUTES=60
