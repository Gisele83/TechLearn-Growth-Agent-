# =============================================================================
# TechLearn Growth Agent — exemple de configuration
# -----------------------------------------------------------------------------
# AUCUNE VALEUR RÉELLE DANS CE FICHIER. Copier en `.env` (ignoré par git) et
# renseigner les valeurs via un gestionnaire de secrets, jamais en clair dans
# le dépôt, les logs, les prompts ou les sorties de tests.
# =============================================================================

# --- Application -------------------------------------------------------------
GA_ENVIRONMENT=local                  # local | staging | production
GA_DEBUG=true
GA_API_HOST=0.0.0.0
GA_API_PORT=8000
GA_LOG_LEVEL=INFO

# Clé de signature des jetons de session. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoire hors environnement local (l'API refuse de démarrer sinon).
GA_SECRET_KEY=

# Origines autorisées pour le navigateur (liste séparée par des virgules).
GA_CORS_ORIGINS=http://localhost:5173

# --- Base de données ---------------------------------------------------------
# PostgreSQL en exécution normale. SQLite est accepté pour les tests locaux.
GA_DATABASE_URL=postgresql+psycopg://growth:growth@localhost:5432/growth_agent

# --- File de tâches ----------------------------------------------------------
GA_REDIS_URL=redis://localhost:6379/0

# --- Connecteur CRM ----------------------------------------------------------
# mock  : adaptateur en mémoire, aucun appel réseau, défaut du MVP local
# hubspot : adaptateur HTTP réel (nécessite un jeton privé et une validation)
GA_CRM_PROVIDER=mock
GA_CRM_BASE_URL=https://api.hubapi.com
GA_CRM_API_TOKEN=
# Débit maximal vers le CRM, appliqué par un limiteur à jetons. Les endpoints
# de recherche de HubSpot ont un quota plus bas que le quota général.
GA_CRM_RATE_LIMIT_PER_SECOND=4
GA_CRM_MAX_RETRIES=5
# Relire la clé d'idempotence côté CRM quand la correspondance locale est
# inconnue. Coûte un appel par première écriture, et protège d'un doublon si
# la base locale a été restaurée ou perdue. À ne désactiver qu'en connaissance
# de cause : un doublon dans le CRM d'un client se voit.
GA_CRM_SEARCH_FALLBACK=true

# Portail HubSpot bac à sable, pour les tests d'intégration réels. Vide en
# temps normal : sans jeton, ces tests sont ignorés. Ils sont de toute façon
# exclus de la suite par défaut (marqueur « integration »).
GA_CRM_SANDBOX_TOKEN=
GA_CRM_SANDBOX_URL=https://api.hubapi.com

# --- Fournisseur LLM ---------------------------------------------------------
# mock : génération déterministe hors ligne, sans coût ni appel réseau
# http : API compatible OpenAI/Anthropic, URL et modèle configurables
GA_LLM_PROVIDER=mock
GA_LLM_BASE_URL=
GA_LLM_MODEL=
GA_LLM_API_KEY=
GA_LLM_MAX_INPUT_TOKENS=6000
GA_LLM_MAX_OUTPUT_TOKENS=1200
GA_LLM_DAILY_TOKEN_BUDGET=200000

# --- Fournisseur de recherche de prospects -----------------------------------
# mock : jeu de données fictif livré avec le dépôt
# http : fournisseur externe (Apollo, Clay, annuaire public…) — vérifier les
#        conditions d'utilisation et la licéité de la collecte avant activation.
GA_SEARCH_PROVIDER=mock
GA_SEARCH_BASE_URL=
GA_SEARCH_API_KEY=

# --- Messagerie sortante -----------------------------------------------------
# mock : aucun email ne quitte la machine, tout est journalisé localement
# smtp : envoi réel — reste inopérant tant que GA_EMAIL_SENDING_ENABLED=false
# mock | smtp | sendgrid
GA_EMAIL_PROVIDER=mock
GA_EMAIL_SENDING_ENABLED=false        # Garde-fou : passer à true seulement après
                                      # validation du domaine, SPF/DKIM/DMARC et
                                      # du cadre juridique du pays ciblé.
GA_EMAIL_FROM=
GA_EMAIL_SMTP_HOST=
GA_EMAIL_SMTP_PORT=587
GA_EMAIL_SMTP_USER=
GA_EMAIL_SMTP_PASSWORD=
# Expéditeur. ATTENTION : noreply@techlearn-saem.com sert déjà aux emails
# transactionnels d'EduCore (vérifié) et de Maintrix (déclaré). Une plainte de
# prospection sur cette adresse dégraderait la délivrabilité des
# réinitialisations de mot de passe. Basculer sur le sous-domaine dédié dès
# que D2 est accordé — voir docs/autorisations/D2-domaine-expedition.md.
# GA_EMAIL_FROM=noreply@growth.techlearn-saem.com

# Boîte RÉELLEMENT surveillée à laquelle les réponses arrivent. Vide, les
# messages cessent d'inviter à répondre « STOP » plutôt que de promettre un
# droit qui se perdrait. Le lien de désinscription, lui, fonctionne toujours.
#
# Boîte confirmée le 16/10/2026 : elle existe et reçoit.
#
# ATTENTION — le traitement des réponses est MANUEL. Rien ne relève cette
# boîte automatiquement. Une personne nommée doit la lire chaque jour ouvré
# et reporter les oppositions via POST /api/v1/replies/analyze. Tant que
# cette adresse est renseignée, les messages promettent « répondez STOP » :
# la promesse n'est tenue que si quelqu'un lit. Voir docs/08-supervision.md.
GA_REPLY_TO_EMAIL=contact@techlearn-saem.com

# --- Relevé de la boîte de réponse -------------------------------------------
# Au-delà de cet âge, le dernier relevé DÉCLARÉ est jugé trop ancien : les
# relances sont mises en attente (motif « stale_inbox »), les premiers
# contacts partent normalement, et les oppositions déjà enregistrées restent
# honorées immédiatement. 96 h par défaut : un relevé le vendredi matin et le
# suivant le lundi matin laissent 72 h parfaitement normales.
GA_INBOX_RELAY_MAX_AGE_HOURS=96

# Destinataires de l'alerte quand le relevé est en retard. Exposés par
# /api/v1/system/alerts, jamais dans une métrique : une adresse dans une
# étiquette Prometheus est une donnée personnelle conservée hors de toute
# politique de rétention. Growth Agent n'envoie pas lui-même ce courriel —
# l'acheminement revient à l'Alertmanager ou à une personne.
GA_INBOX_RELAY_OWNER_EMAIL=
# Une personne unique est un point de panne. Voir docs/08-supervision.md,
# section « Suppléance et reprise après absence ».
GA_INBOX_RELAY_DEPUTY_EMAIL=

# --- SendGrid ----------------------------------------------------------------
GA_SENDGRID_API_KEY=
GA_SENDGRID_BASE_URL=https://api.sendgrid.com
# Bac à sable : SendGrid valide la requête et NE LIVRE RIEN. C'est la seule
# façon d'éprouver l'intégration réelle — authentification, expéditeur
# vérifié, forme de la charge — sans qu'un message atteigne qui que ce soit.
# Laisser à true jusqu'au procès-verbal de mise en service.
GA_SENDGRID_SANDBOX_MODE=true

GA_EMAIL_MAX_PER_CONTACT_PER_30_DAYS=2
GA_EMAIL_MAX_PER_CAMPAIGN_PER_DAY=50

# Adresse publique de l'application, sans barre finale. C'est elle qui forme
# le lien de désinscription inséré dans chaque message et dans l'en-tête
# List-Unsubscribe. Sans elle, GA_EMAIL_SENDING_ENABLED=true ne suffit pas :
# l'envoi réel reste refusé. Un message commercial dont le lien de
# désinscription pointe vers localhost est un message qu'on ne peut pas quitter.
GA_PUBLIC_BASE_URL=

# --- Supervision -------------------------------------------------------------
# Jeton présenté en Bearer par le collecteur de métriques. Vide : /metrics
# répond 404. L'endpoint n'est jamais ouvert par défaut — les mesures portent
# des chiffres commerciaux, et un endpoint laissé ouvert « le temps de
# configurer » ne se referme jamais.
GA_METRICS_TOKEN=

# Fichier témoin touché par monitoring/backup.sh après un transfert vérifié.
# Un fichier plutôt qu'une table : une sauvegarde doit pouvoir être constatée
# même quand la base est en panne, c'est-à-dire précisément quand cela compte.
GA_BACKUP_STAMP_PATH=/var/lib/growth-agent/derniere-sauvegarde

# --- Connecteurs produits (Maintrix / EduCore) -------------------------------
# LECTURE SEULE. Les adaptateurs HTTP réels restent désactivés tant que les
# endpoints n'existent pas et n'ont pas été explicitement autorisés par les
# responsables de chaque plateforme. Voir docs/11-dependances-autorisation.md.
GA_MAINTRIX_ADAPTER=mock              # mock | http
GA_MAINTRIX_ENABLED=false
GA_MAINTRIX_BASE_URL=
GA_MAINTRIX_API_TOKEN=
GA_MAINTRIX_WEBHOOK_SECRET=

GA_EDUCORE_ADAPTER=mock               # mock | http
GA_EDUCORE_ENABLED=false
GA_EDUCORE_BASE_URL=
GA_EDUCORE_API_TOKEN=
GA_EDUCORE_WEBHOOK_SECRET=

# --- Identité de l'expéditeur ------------------------------------------------
# Un message de prospection est signé par une personne. Sans nom renseigné, la
# rédaction est refusée : un message anonyme se repère immédiatement.
GA_SENDER_NAME=
GA_SENDER_ROLE=
GA_SENDER_ORGANIZATION=TechLearn

# --- Conformité --------------------------------------------------------------
GA_DATA_RETENTION_DAYS=365            # Prospects non convertis
GA_DEFAULT_LEGAL_REGIME=FR            # FR | CM — règles de prospection appliquées par défaut

# --- Purge des données échues ------------------------------------------------
# Voir docs/07-politique-de-retention.md pour la justification de chaque durée.
GA_DRAFT_RETENTION_DAYS=180           # Contenu des messages
GA_AUDIT_RETENTION_DAYS=1095          # Journal d'audit (3 ans)
GA_PILOT_EVENT_RETENTION_DAYS=1825    # Événements de pilote (5 ans)

# Garde-fou principal : sans cette activation, aucune suppression n'a lieu.
GA_PURGE_ENABLED=false
# Même activée, la purge simule par défaut ; il faut `--apply` pour écrire.
GA_PURGE_DRY_RUN_DEFAULT=true
# Plafond par exécution ; le reliquat est traité à l'exécution suivante.
GA_PURGE_MAX_RECORDS_PER_RUN=5000
# Arrêt si une règle voulait purger plus de cette part d'une table : c'est le
# garde-fou qui rattrape une durée de conservation mal saisie.
GA_PURGE_MAX_TABLE_RATIO=0.5
GA_PURGE_BATCH_SIZE=200
GA_PURGE_LOCK_TIMEOUT_MINUTES=60
